# Mind 服务环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== 必需 ==========
# 火山方舟 (Ark) 平台 API Key
# 获取地址: https://console.volcengine.com/ark
API_KEY=

# ========== 服务器 ==========
# SERVER_HOST=0.0.0.0
# SERVER_PORT=6788

# ========== LLM ==========
# LLM_API_KEY=
# LLM_MODEL=gpt-4

# ========== NATS 消息通信 ==========
# NATS_URL=nats://localhost:4222

# ========== Milvus 向量数据库（可选） ==========
# MILVUS_ADDR=localhost:19530
# MILVUS_COLLECTION=aquaculture_knowledge
# MILVUS_USERNAME=
# MILVUS_PASSWORD=
# MILVUS_DB_NAME=default

# ========== 数据库（可选） ==========
# DATABASE_DSN=

# ========== Bing 搜索（可选） ==========
# BING_SEARCH_API_KEY=
